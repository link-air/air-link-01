<!DOCTYPE html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=edge" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>air-link-01 · 开关</title>
<hta:application
  id="airSwitch"
  applicationname="airSwitch"
  border="thin"
  caption="yes"
  sysmenu="yes"
  maximizebutton="no"
  minimizebutton="yes"
  scroll="no"
  contextmenu="no"
  selection="no"
  innerborder="no"></hta:application>
<style>
  html { height: 100%; }
  body {
    margin: 0; height: 100%;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    background: #f6f3ec; color: #2b2620;
    -ms-user-select: none;
  }
  .wrap { padding: 20px 22px 17px; }
  h1 { font-size: 20px; font-weight: 600; margin: 0 0 14px; letter-spacing: .5px; }
  .st { font-size: 17px; line-height: 1.9; color: #5a5347; }
  .dot { display: inline-block; width: 11px; height: 11px;
         background: #c2b9a8; margin-right: 8px; }
  .on { background: #5f9e5f; }
  button {
    display: block; width: 100%; padding: 13px 0; margin: 11px 0 0;
    border: 1px solid #c9c0ad; border-radius: 11px; background: #fffdf8;
    font-size: 20px; font-family: inherit; color: #2b2620; cursor: pointer;
  }
  button:hover { background: #f0e9db; }
  button.main { background: #8a6d3b; border-color: #8a6d3b; color: #fff; }
  button.main:hover { background: #7a5f33; }
  button:disabled { opacity: .5; cursor: default; }
  .msg { font-size: 17px; line-height: 1.7; color: #8a6d3b;
        margin-top: 14px; word-break: break-all; }
  a { color: #8a6d3b; }
</style>
</head>
<body>
<div class="wrap" id="wrap">
  <h1>air-link-01 · 开关</h1>
  <div class="st"><span id="d1" class="dot"></span>仪表盘：<span id="s1">查询中…</span>
    <a id="openLink" href="javascript:void(0)" onclick="return openPage()"
       style="display:none;margin-left:8px">打开页面</a></div>
  <div class="st"><span id="d2" class="dot"></span>语音服务：<span id="s2">查询中…</span></div>
  <button id="bStart" class="main" onclick="startAll()">全拉起</button>
  <button id="bQuit" onclick="quitAll()">优雅退出</button>
  <div class="msg" id="msg">「全拉起」= 双击 启动.vbs；「优雅退出」= 先收语音服务（放显存），再关仪表盘。</div>
</div>
<script language="javascript">
var PORT = 8765;
var BASE = "http://127.0.0.1:" + PORT;
var DEFAULT_TTS = "http://127.0.0.1:8977";

// 所在目录（项目根）：从本文件自己的路径推出来，整包挪走也不用改。
var _p = decodeURIComponent(String(location.pathname || ""));
_p = _p.replace(/[^\/\\]+$/, "");
if (_p.charAt(0) === "/" && _p.charAt(2) === ":") { _p = _p.substring(1); }
var root = _p.replace(/\//g, "\\");

function $(id) { return document.getElementById(id); }
function msg(t) { $("msg").innerHTML = t; }
function setDot(el, on) { el.className = on ? "dot on" : "dot"; }

// 同步请求。**超时都要给短**：这是同步调用，给长了整窗冻结。
function http(method, url, body, ms) {
  try {
    var x = new ActiveXObject("MSXML2.ServerXMLHTTP");
    x.setTimeouts(ms || 1500, ms || 1500, ms || 3000, ms || 8000);
    x.open(method, url, false);
    if (method !== "GET") { x.setRequestHeader("Content-Type", "application/json"); }
    x.send(method === "GET" ? "" : (body || ""));
    return { ok: true, code: x.status, text: x.responseText };
  } catch (e) {
    return { ok: false, err: String((e && e.message) || e) };
  }
}

// 语音服务的地址：优先读 config.local.json（他改过端点也认得），否则用默认。
function ttsEndpoint() {
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 2; s.Charset = "utf-8"; s.Open();
    s.LoadFromFile(root + "config.local.json");
    var t = s.ReadText(); s.Close();
    var j = JSON.parse(t);
    if (j && j.tts && j.tts.endpoint) {
      return String(j.tts.endpoint).replace(/\/+$/, "");
    }
  } catch (e) {}
  return DEFAULT_TTS;
}

// 在 HTA 里点链接会在**自己的窗口里导航**（窗口就不是开关了）——
// 所以外部页面一律交给系统默认浏览器打开。
function openPage() {
  try { new ActiveXObject("WScript.Shell").Run(BASE + "/", 1, false); } catch (e) {}
  return false;
}

function refresh() {
  var r = http("GET", BASE + "/api/state", null, 1200);
  var running = r.ok && r.code === 200;
  setDot($("d1"), running);
  $("s1").textContent = running ? "运行中" : "未运行";
  $("openLink").style.display = running ? "inline" : "none";
  if (running) {
    var v = http("GET", BASE + "/api/voice", null, 8000);
    var up = false;
    try { up = !!(JSON.parse(v.text).status.ok); } catch (e) { up = false; }
    setDot($("d2"), up);
    $("s2").textContent = up ? "在（已接上）" : "没接上";
  } else {
    setDot($("d2"), false);
    $("s2").textContent = "—（仪表盘不在跑）";
  }
}

function startAll() {
  msg("正在拉起……浏览器没自动弹出的话，就到 " + BASE + "/ 手动打开。");
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    if (!fso.FileExists(root + "启动.vbs")) {
      msg("找不到 启动.vbs——开关.hta 要和它放在同一个目录。");
      return;
    }
    var sh = new ActiveXObject("WScript.Shell");
    // 复用 启动.vbs 的整套逻辑：没跑 → pythonw 起（连语音一起）；
    // 已在跑 → 只开页面 + 确保语音服务在（幂等，不会起第二份）。
    sh.Run('wscript.exe "' + root + '启动.vbs"', 0, false);
  } catch (e) {
    msg("拉不起来：" + ((e && e.message) || e));
  }
  setTimeout(refresh, 2500);
  setTimeout(refresh, 8000);
}

// 仪表盘的收尾进程还在吗。**端口关了 ≠ 退了**：它还要提取最后一段对话 + 整理
// （要调 LLM），实测 1~3 分钟——任务管理器里那个占用很小的 python 就是它。
// 按命令行认（pythonw -m core.dashboard）；查不动返回 null，由调用方兜底。
function dashProcAlive() {
  try {
    var wmi = GetObject("winmgmts:\\\\.\\root\\cimv2");
    var col = wmi.ExecQuery(
      "SELECT ProcessId FROM Win32_Process WHERE CommandLine LIKE '%core.dashboard%'");
    return col.Count > 0;
  } catch (e) {
    return null;
  }
}

var _closingShown = false;   // "在收尾"那句提示只说一次

function waitGone(n) {
  if (n === 0) { _closingShown = false; }
  // 等待上限给足：收尾要跑 LLM，实测 1~3 分钟是常态（300 × 800ms = 4 分钟）。
  if (n > 300) {
    msg("等了四分钟还没退干净——可以再点一次「优雅退出」，或到设置页点「全退出」。");
    refresh();
    $("bQuit").disabled = false;
    return;
  }
  setTimeout(function () {
    var r = http("GET", BASE + "/api/state", null, 1000);
    if (r.ok && r.code === 200) {          // 仪表盘还在跑：继续等它松口
      waitGone(n + 1);
      return;
    }
    // 端口已关：**再核进程**——那期间它正在收尾。别把它当成"没退掉"，
    // 更别在任务管理器里强杀（强杀会跳过收尾，最后一段对话就丢了）。
    var alive = dashProcAlive();
    if (alive === true) {
      if (!_closingShown) {
        _closingShown = true;
        msg("仪表盘已经不接新对话了——它正在收尾（提取最后一段对话 + 整理），"
            + "通常 1~2 分钟。任务管理器里那个占用很小的 python 就是它在干活，别关它，稍等……");
      }
      waitGone(n + 1);
      return;
    }
    msg("已全部退出：语音服务放掉了显存，仪表盘也关了、进程退干净了。");
    refresh();
    $("bQuit").disabled = false;
  }, 800);
}

function quitAll() {
  $("bQuit").disabled = true;
  var st = http("GET", BASE + "/api/state", null, 1200);
  if (st.ok && st.code === 200) {
    msg("正在优雅退出：先收语音服务（放显存），再关仪表盘……");
    // 服务端**先回话、后台收尾**（见 dashboard 的 /api/quit）：这里很快就回来。
    http("POST", BASE + "/api/quit", "{}", 8000);
    waitGone(0);
    return;
  }
  // 仪表盘没在跑：看看语音服务是不是还单独开着（上次遗留 / 手动起的），能收就收。
  var ep = ttsEndpoint();
  var h = http("GET", ep + "/health", null, 1500);
  if (h.ok && h.code === 200) {
    msg("仪表盘没在跑；语音服务还开着，正在让它退出（放显存）……");
    var s = http("POST", ep + "/shutdown", "{}", 6000);
    msg(s.ok ? "语音服务已退出（显存放掉了）。"
             : ("语音服务没能退出：" + (s.err || ("HTTP " + s.code))
                + "——可在任务管理器里结束它的 python。"));
  } else {
    msg("仪表盘和语音服务都没在跑——没什么可退的。");
  }
  refresh();
  $("bQuit").disabled = false;
}

// 窗口大小：宽度定死（换行随宽度走），高度按内容实测——以后改字号不用手算。
// PAD 是底部余量：字体渲染各处差几个像素时，别让最后一行刚好被切掉。
function fitWindow() {
  var W = 532, PAD = 22;
  window.resizeTo(W, 560);            // 先把宽度定下来（顺带给足高，别出滚动条）
  var fit = function () {
    var chromeH = (window.outerHeight || 0) - (window.innerHeight || 0); // 标题栏+边框
    if (!(chromeH > 0) || chromeH > 200) { chromeH = 48; }               // 量不准就用常见值兜底
    window.resizeTo(W, $("wrap").offsetHeight + chromeH + PAD);
  };
  fit();                    // 先摆一次（尽量不闪）
  setTimeout(fit, 60);      // 宽度生效后再量一次才准，这里复校
}
fitWindow();
refresh();
setInterval(refresh, 10000);
</script>
</body>
</html>
